{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBettys",
  "version": "2.0.0",
  "identifier": "com.mybettys.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kleber Barilli",
    "copyright": "© 2026 Kleber Barilli",
    "category": "Finance",
    "shortDescription": "Acompanhamento de apostas na Polymarket, Kalshi, Predict.fun e SX Bet",
    "longDescription": "MyBettys reúne posições, histórico e estatísticas das casas Polymarket, Kalshi, Predict.fun e SX Bet. O acesso às casas é somente leitura: o app nunca envia ordens.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
